                                <Panel class="chaoticEraShopCost_special">
                                    <Panel id="goldIcon" />
                                    <Label text="{s:cost}"/>
                                </Panel>
                                
                            </Panel>

                            <!-- 注释：刷新怪物征召，通过hidden隐藏 原class：singleSpeicalItem-->
                            <Panel id="TaskRefreshPanel" class="hidden"  >
                                <Panel class="singleSpecialItemRoot">
                                    <Panel id="TaskRefresh_Image"/>
