                                        <CircularProgressBar id = "UpgradeProgress_PieChart_CircleBar"  value="60" min="0" max ="100" ></CircularProgressBar>
                                    </Panel>
                                </Panel>
                                <Label id="chaoticEraShopUpgrade_exp"  text="#DOTA_HUD_ChaoticEraShop_Upgrade"/>

                            </Panel>
                            
				            <Button id="ChaoticEraButton_RefreshShop" onactivate="RefreshChaoticEraShop();" onmouseover="DOTAShowTextTooltip('#HUD_ChaoticEra_RefreshShop')" onmouseout="DOTAHideTextTooltip()">  
