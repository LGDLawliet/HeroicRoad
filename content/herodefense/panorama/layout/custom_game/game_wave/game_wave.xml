      <Button id="CheckFellOmenBuff"  onactivate="CheckFellOmenBuff();"  onmouseover="DOTAShowTextTooltip('#DOTA_HUD_CheckFellOmen')" onmouseout="DOTAHideTextTooltip()">    </Button>
      <Panel id="FellOmenPanelRoot" hittest="false" onactivate="CloseFellOmenBuff();">
