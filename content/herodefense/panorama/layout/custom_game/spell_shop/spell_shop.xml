                            </Panel>

                            <!-- 购买升级机会，通过hidden隐藏，原class：singleSpeicalItem -->
                            <Panel id="UpgradePanel" class="hidden"  >
                                <Panel class="singleSpecialItemRoot">
                                    <Panel id="spellUpgrade_Image"/>
                                    <!-- <Panel class="itemOverlay"  hittest="false"/> -->
                                    <Label id="itemCharge" class="itemChargeLabel" text="{s:charge}/{s:max}"/>
                                </Panel>
                                
