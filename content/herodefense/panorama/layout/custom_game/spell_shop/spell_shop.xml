                                <Panel id="chaoticEraShopUpgradeCost" class="chaoticEraShopCost">
                                    <Panel id="goldIcon" />
                                    <Label text="{s:value}"/>
                                       
                                </Panel>
                                <!--进度饼图 -->
                                <Panel id="UpgradeProgress_PieChart" hittest="false" class="Visible">
                                    <Label  text="{s:level}"/>
