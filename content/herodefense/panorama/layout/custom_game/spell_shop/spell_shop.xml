                                    <Label id="itemCharge" class="itemChargeLabel" text="{s:charge}/{s:max}"/>
                                </Panel>
                                
                                <Panel class="chaoticEraShopCost_special">
                                    <Panel id="goldIcon" />
                                    <Label text="{s:cost}"/>
                                </Panel>
                                
                            </Panel>




                        </Panel>
                    </Panel>

                    <!-- 商店特殊按钮队列 -->
                    <Panel id="chaoticEra_ShopSpecialButton">
                        <Panel class="singleItemListBlockBG"/>
                        <Panel class="ButtonList">
                            <Panel id="ChaoticEraButton_UpgrateShop" onactivate="UpgradeChaoticEraShop();" onmouseover="DOTAShowTextTooltip('#HUD_ChaoticEra_Shop')" onmouseout="DOTAHideTextTooltip()">
