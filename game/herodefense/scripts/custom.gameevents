 	// }

	
	"dota_hd_challenge_init"
	{
		"unit"			"short"
		"difficulty" 	"short"
		"challengeName"	"string"
 	}

	"hd_get_unit_data"
	{
		// "modifier_index"			"short"
		"unit_ent_index"			"short"
		"function_name"				"string"
	}
	"openArtifactList"{
		// "unit"			"short"
	}


	"hd_data_syn"
	{
		"data_name"			"string"
		"value"		"short"
 	}
	"hd_data_syn_abilityCustomValue"
	{
		"ability"				"short"
		"data_name"			"string"
		"value"		"short"
 	}
	"ability_custom_indicator"
	{
		"type"			"string"
		"ownerIndex"	"short"
		"targetIndex"	"short"
		"abilityName"	"string"
		"x"				"float"
		"y"				"float"
		"z"				"float"
		"startX"		"float"
		"startY"		"float"
		"startZ"		"float"
		"forwardX"		"float"
		"forwardY"		"float"
		"forwardZ"		"float"
		"overlap"		"bool"
		"AOERadius"		"float"
	}
}

